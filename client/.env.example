# API Configuration
# For local development (localhost:8000/api is default)
# NEXT_PUBLIC_API_URL=http://localhost:8000/api

# For production on Vercel (update with your actual render.com backend URL)
NEXT_PUBLIC_API_URL=https://babymart-full-stack-mern-ecommerce-3xsp.onrender.com/api

# Server-side API endpoint (optional, used for SSR)
API_ENDPOINT=https://babymart-full-stack-mern-ecommerce-3xsp.onrender.com/api

# Stripe keys (if using payment)
# NEXT_PUBLIC_STRIPE_PUBLIC_KEY=pk_test_...
# STRIPE_SECRET_KEY=sk_test_...

# App environment (set to production when deployed)
NEXT_PUBLIC_APP_ENV=production

# Production site URL (for sitemap/SEO - no trailing slash)
NEXT_PUBLIC_SITE_URL=https://your-client-domain.vercel.app
