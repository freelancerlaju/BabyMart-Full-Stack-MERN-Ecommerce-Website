# Server - copy to .env and fill in values
# Required for deployment

# Database
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/babyshop?retryWrites=true&w=majority

# Server
PORT=8000
NODE_ENV=production

# CORS - your deployed frontend URLs (comma-separated if multiple)
CLIENT_URL=https://your-client-domain.vercel.app
ADMIN_URL=https://your-admin-domain.vercel.app

# Auth
JWT_SECRET=your-super-secret-jwt-key-min-32-chars

# Cloudinary (images)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email (optional - for order/contact emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=BabyShop <your-email@gmail.com>
